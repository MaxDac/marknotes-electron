{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable", "ESNext.Array"],
    "types": ["node"]
  },
  "include": [
    "src/main/**/*",
    "src/preload/**/*",
    "src/shared/**/*",
    "electron.vite.config.ts",
    "vitest.config.ts",
    "vitest.parity.config.ts",
    "parity/**/*",
    "playwright.config.ts",
    "e2e/**/*",
    "test/**/*",
    "scripts/**/*"
  ]
}
