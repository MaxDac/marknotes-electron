{
  "name": "marknotes-desktop",
  "productName": "MarkNotes",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop markdown notes with folders and sync to Proton Drive (unofficial), Dropbox and OneDrive",
  "author": {
    "name": "MaxDac",
    "email": "25101798+MaxDac@users.noreply.github.com"
  },
  "desktopName": "marknotes.desktop",
  "license": "SEE LICENSE IN LICENSE.md",
  "homepage": "https://github.com/MaxDac/marknotes-electron",
  "main": "out/main/index.js",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/apply-dependency-patches.ts && node scripts/install-electron.ts",
    "deps:check": "node scripts/check-dependencies.ts",
    "deps:audit": "node scripts/check-dependencies.ts audit",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:parity": "vitest run --config vitest.parity.config.ts",
    "e2e": "playwright test",
    "dist": "electron-vite build && electron-builder"
  },
  "dependencies": {
    "@azure/msal-node": "^7.1.0",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@marknotes/sync": "https://github.com/MaxDac/marknotes-sync/releases/download/v0.1.1/marknotes-sync-0.1.1.tgz",
    "@protontech/drive-sdk": "^0.23.0",
    "bcryptjs": "^3.0.3",
    "electron-updater": "6.8.11",
    "highlight.js": "^11.12.0",
    "idb": "^8.0.4",
    "markdown-it": "^15.0.3",
    "openpgp": "^6.3.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.9.0",
    "electron-builder": "26.18.0",
    "electron-vite": "^6.0.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.6",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "app-builder-lib@26.18.0": {
      "@electron/asar": "4.3.1",
      "@electron/universal": {
        "@electron/asar": "4.3.1"
      }
    },
    "electron-winstaller@5.4.0": {
      "@electron/asar": "4.3.1"
    },
    "electron-updater@6.8.11": {
      "lodash.isequal": "npm:fast-deep-equal@3.1.3"
    },
    "temp@0.9.4": {
      "rimraf": "6.1.3"
    },
    "@electron/get@^3.0.0": {
      "global-agent": "^4.1.3"
    }
  },
  "build": {
    "appId": "io.github.maxdac.marknotes",
    "productName": "MarkNotes",
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "onlyLoadAppFromAsar": true,
      "enableEmbeddedAsarIntegrityValidation": true,
      "enableCookieEncryption": true
    },
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "publish": {
      "provider": "github",
      "owner": "MaxDac",
      "repo": "marknotes-electron"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "maintainer": "MaxDac <25101798+MaxDac@users.noreply.github.com>",
      "vendor": "MaxDac",
      "executableName": "marknotes",
      "syncDesktopName": true,
      "synopsis": "Markdown notes with folders and multi-drive sync",
      "description": "Offline-first markdown notes with folders, note links and images, synced to Proton Drive (unofficial), Dropbox and OneDrive.",
      "artifactName": "${productName}-${version}-linux-${arch}.${ext}",
      "icon": "build/icons",
      "desktop": {
        "entry": {
          "GenericName": "Markdown Notes",
          "Keywords": "markdown;notes;notebook;sync;",
          "StartupNotify": "true"
        }
      }
    },
    "deb": {
      "fpm": [
        "--category=editors"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}"
    }
  },
  "allowScripts": {
    "electron@44.7.0": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "electron-winstaller@5.4.0": true,
    "core-js": false,
    "exifreader": false
  }
}
